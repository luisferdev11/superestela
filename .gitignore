# ---------------------------------------------------------------------------
# Competition data. NEVER enters git, on any path.
# Redistributing the dataset violates the competition rules; see CONVENTIONS.md
# section 8 rule 4. A pre-commit hook enforces this independently.
# ---------------------------------------------------------------------------
data/
*.parquet
*.xlsx
*.docx

# Secrets
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/

# Node
node_modules/
.next/
.turbo/

# MLflow local store
mlruns/
mlflow.db

# Fitted models. Derived from the licensed dataset, so they stay out of git
# like the data does (CONVENTIONS.md section 8 rule 4).
artifacts/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
